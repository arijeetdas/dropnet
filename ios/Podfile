platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise 'FLUTTER_ROOT not found in Generated.xcconfig.'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  pod 'SwiftTryCatch', :git => 'https://github.com/williamFalcon/SwiftTryCatch.git'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # NOTE: permission_handler_apple is resolved via Swift Package Manager
      # now (see ios/Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage),
      # not CocoaPods, so this no longer reaches it — these macros only
      # affect actual CocoaPods targets. permission_handler_apple's own
      # Package.swift resolves PERMISSION_CAMERA/PERMISSION_PHOTOS from (in
      # order) the PERMISSION_CAMERA/PERMISSION_PHOTOS launchd env vars, then
      # the app's Info.plist usage-description keys, then defaults to off.
      # It cannot auto-detect the app root when built from Xcode.app (working
      # directory is "/"), so `launchctl setenv PERMISSION_CAMERA 1` (and
      # PERMISSION_PHOTOS) on the dev machine is what makes Xcode-driven
      # builds pick these up — CLI builds (`flutter run`/`flutter build ios`)
      # auto-detect correctly via Info.plist without needing this at all.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_CAMERA=1'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'PERMISSION_PHOTOS=1'
    end
  end
end
